<?xml version="1.0" encoding="utf-8"?>
<!--
This code is using some unix abreviations such as
r -> 'read' permission
rw -> 'read' and 'write' permission
-->
<odoo>
    <data noupdate="0">
    <!-- 'registers' main menu and superuser group -->
        <record id="model_category_registers" model="ir.module.category">
            <field name="name">Sistema</field>
            <field name="sequence">5</field>
        </record>

        <record id="group_registers_superuser" model="res.groups">
            <field name="name">Superusuário</field>
            <field name="category_id" ref="registers.model_category_registers"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Acesso a todos os modelos com edição.</field>
        </record>

        <!-- 'employee' groups and access rights -->
        <record id="group_registers_employee_r" model="res.groups">
            <field name="name">Funcionário (Leitura)</field>
            <field name="category_id" ref="registers.model_category_registers"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Acesso apenas à leitura do modelo "Funcionário".</field>
        </record>

        <record id="group_registers_employee_rw" model="res.groups">
            <field name="name">Funcionário (Edição)</field>
            <field name="category_id" ref="registers.model_category_registers"/>
            <field name="implied_ids" eval="[(4, ref('registers.group_registers_employee_r'))]"/>
            <field name="comment">Acesso à leitura e modificação do modelo "Funcionário".</field>
        </record>

        <!-- 'client' groups and access rights -->
        <record id="group_registers_client_r" model="res.groups">
            <field name="name">Cliente (Leitura)</field>
            <field name="category_id" ref="registers.model_category_registers"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Acesso apenas à leitura do modelo "Cliente".</field>
        </record>

        <record id="group_registers_client_rw" model="res.groups">
            <field name="name">Cliente (Edição)</field>
            <field name="category_id" ref="registers.model_category_registers"/>
            <field name="implied_ids" eval="[(4, ref('registers.group_registers_client_r'))]"/>
            <field name="comment">Acesso à leitura e modificação do modelo "Cliente".</field>
        </record>

        <!-- 'patrimony' groups and access rights -->
        <record id="group_registers_patrimony_r" model="res.groups">
            <field name="name">Patrimônios (Leitura)</field>
            <field name="category_id" ref="registers.model_category_registers"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Acesso apenas à leitura do modelo "Patrimônios".</field>
        </record>

        <record id="group_registers_patrimony_rw" model="res.groups">
            <field name="name">Patrimônios (Edição)</field>
            <field name="category_id" ref="registers.model_category_registers"/>
            <field name="implied_ids" eval="[(4, ref('registers.group_registers_patrimony_r'))]"/>
            <field name="comment">Acesso à leitura e modificação do modelo "Patrimônios".</field>
        </record>

    </data>
</odoo>