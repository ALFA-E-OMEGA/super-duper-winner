<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_patrimony_form" model="ir.ui.view">
        <field name="name">patrimony.form</field>
        <field name="model">patrimony</field>
        <field name="arch" type="xml">
            <form class="myform" string="Cadastramento de Patrimônio">

                <div class="container_form patrimony_form">
                    <h1>Cadastramento de Patrimônio</h1>
                    <article class="container_form_contents">
                        <section class="group">
                            <div class="subgroup">
                                <div class="container_field">
                                    <span>Código:</span>
                                    <field class="field" name="id_patrimony" />
                                </div>

                                <div class="container_field">
                                    <span>Status:</span>
                                    <field class="field" name="status" />
                                </div>

                            </div>

                            <div class="subgroup">
                                <div class="container_field">
                                    <span>Marca:</span>
                                    <field class="field" name="vehicle_maker" />
                                </div>

                                <div class="container_field">
                                    <span>Modelo:</span>
                                    <field class="field" name="vehicle_model" />
                                </div>

                            </div>

                            <div class="subgroup">
                                <div class="container_field"
                                    invisible="classification != 'veiculo' and classification != 'pesado'">
                                    <span>Tipo de Combustível:</span>
                                    <field class="field" name="fuel_type" />
                                </div>

                                <div class="container_field">
                                    <span>Data de Aquisição:</span>
                                    <field class="field" name="acquisition_date" />
                                </div>

                            </div>

                            <div class="subgroup">
                                <div class="container_field">
                                    <span>Arquivo PDF:</span>
                                    <div invisible="pdf_view_status == 1">
                                        <field class="field" name="patrimony_file"
                                            filename="filename"
                                            widget="pdf_viewer" />
                                    </div>

                                    <div invisible="pdf_view_status == 0">
                                        <field class="field" name="patrimony_file"
                                            filename="filename" />
                                    </div>

                                    <field class="field" name="filename" invisible="1" />
                                </div>

                                <div class="container_button">
                                    <div invisible="pdf_view_status == 1 or patrimony_file == False">
                                        <button name="update_pdf_view" class="btnSecondary mybutton"
                                            type="object" string="Ver PDF" />
                                    </div>

                                    <div invisible="pdf_view_status == 0 or patrimony_file == False">
                                        <button name="update_pdf_view" class="btnSecondary mybutton"
                                            type="object" string="Fechar PDF" />
                                    </div>

                                </div>

                            </div>

                            <div class="container_field"
                                invisible="classification != 'veiculo' and classification != 'pesado'">
                                <span>Contratos:</span>
                                <field name="contract_ids"
                                    options="{'unlink': False, 'create': False, 'edit': False}"
                                    readonly="1" />
                            </div>

                        </section>
                        <section class="group">
                            <div class="subgroup">
                                <div class="container_field"
                                    invisible="classification != 'veiculo' and classification != 'pesado'">
                                    <span>Contrato Original:</span>
                                    <field class="field" name="external_contract_id"
                                        widget="selection" />
                                </div>
                                <div class="container_field">
                                    <span>Classificação:</span>
                                    <field class="field" name="classification" />
                                </div>
                            </div>

                            <div class="subgroup">
                                <div class="container_field" invisible="classification != 'veiculo'">
                                    <span>Tipo de Veículo:</span>
                                    <field class="field" name="vehicle_type"
                                        required="classification == 'veiculo'" />
                                </div>

                                <div class="container_field" invisible="classification != 'veiculo'">
                                    <span>Renavan:</span>
                                    <field class="field" name="renavan"
                                        required="classification == 'veiculo'" />
                                </div>

                            </div>

                            <div class="container_field" invisible="classification != 'pesado'">
                                <span>Tipo de Veículo:</span>
                                <field class="field" name="heavy_type"
                                    required="classification == 'pesado'" />
                            </div>

                            <div class="subgroup">
                                <div class="container_field" invisible="classification != 'pesado'">
                                    <span>Número do equipamento:</span>
                                    <field class="field" name="heavy_number"
                                        required="classification == 'pesado'" />
                                </div>

                                <div class="container_field" invisible="classification != 'veiculo'">
                                    <span>Placa do Veículo:</span>
                                    <field class="field" name="vehicle_plate"
                                        required="classification == 'veiculo'" />
                                </div>

                                <div class="container_field">
                                    <span>Valor do Patrimômio</span>
                                    <field class="field" name="value" />
                                </div>

                            </div>
                            
                            <div class="subgroup">
                                <div class="container_button">
                                    <button name="create_patrimony" class="btnSecondary mybutton"
                                        type="object" string="Salvar"
                                        groups="registers.group__registers_patrimony_rw,registers.group_registers_superuser"
                                        confirm="Confimar dados de patrimônio?" />

                                </div>

                                <div class="container_button">
                                    <button name="remove_last_contract" class="btnSecondary mybutton"
                                        type="object" string="Limpar Contrato"
                                        groups="registers.group__registers_patrimony_rw,registers.group_registers_superuser"
                                        confirm="Remover patrimônio do último contrato?" />

                                </div>
                            
                            </div>

                            <div class="container_field">
                                <span>Contas:</span>
                                <field name="bill_ids" readonly="1" />
                            </div>

                        </section>

                    </article>

                </div>

                <div class="oe_chatter"
                groups="registers.group_registers_superuser">
                    <field name="message_ids" widget="mail.thread"
                    readonly="1"/> 
                </div>
                
            </form>


        </field>

    </record>

    <record id="view_patrimony_list" model="ir.ui.view">
        <field name="name">patrimony.list</field>
        <field name="model">patrimony</field>
        <field name="arch" type="xml">
            <list string="Patrimônio">
                <field class="test" name="id_patrimony" />
                <field class="test" name="vehicle_maker" />
                <field class="test" name="vehicle_model" />
                <field class="test" name="value" />
            </list>
        </field>
    </record>

    <record id="action_register_patrimony" model="ir.actions.act_window">
        <field name="name">Patrimônios</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">patrimony</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>