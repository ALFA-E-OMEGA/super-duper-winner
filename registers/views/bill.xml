<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bill_form" model="ir.ui.view">
        <field name="name">bill.form</field>
        <field name="model">bill</field>
        <field name="arch" type="xml">
            <form class="myform" string="Cadastro de Conta">

                <div class="container_form bill_form">
                    <h1>Despesa</h1>
                    <article class="container_form_contents">
                        <section class="group">
                            <div class="subgroup">
                                <div class="container_field">
                                    <span>Código:</span>
                                    <field class="field" name="id_bill"
                                        readonly="bill_status != '0'" />
                                </div>

                                <div class="container_field">
                                    <span>Nota Fiscal:</span>
                                    <field class="field" name="fiscal_note"
                                        readonly="bill_status != '0'" />
                                </div>

                            </div>

                            <div class="container_field">
                                <span>Valor da conta:</span>
                                <field class="field" name="value" readonly="bill_status != '0'" />
                            </div>

                            <div class="subgroup">
                                <div class="container_field">
                                    <span>Centro de Custo:</span>
                                    <field class="field" name="external_cost_center_id"
                                        widget="selection"
                                        readonly="bill_status != '0'" />
                                </div>

                                <div class="container_field">
                                    <span>Parcela:</span>
                                    <field class="field" name="installment"
                                        readonly="bill_status != '0'" />
                                </div>

                            </div>

                            <div class="container_field">
                                <span>Origem:</span>
                                <field class="field" name="origin" readonly="bill_status != '0'" />
                            </div>

                            <div class="subgroup">
                                <div class="container_field" invisible="origin != 'funcionario'">
                                    <span>Nome:</span>
                                    <field class="field" name="external_employee_id"
                                        domain="[('status', '=', 'ativo')]"
                                        widget="selection"
                                        readonly="bill_status != '0'" />
                                </div>

                                <div class="container_field" invisible="origin != 'cliente'">
                                    <span>Nome:</span>
                                    <field class="field" name="external_client_id"
                                        widget="selection"
                                        readonly="bill_status != '0'" />
                                </div>

                                <div class="container_field"
                                    invisible="external_client_type == 'pessoa-juridica'
                                or origin == 'outro'">
                                    <span>CPF:</span>
                                    <field class="field" name="cpf" readonly="1" />
                                </div>

                                <div class="container_field"
                                    invisible="external_client_type != 'pessoa-juridica'">
                                    <span>CNPJ:</span>
                                    <field class="field" name="cnpj" readonly="1" />
                                </div>

                            </div>

                            <div class="subgroup">

                                <div class="container_field">
                                    <span>Arquivo PDF:</span>
                                    <div invisible="pdf_view_status == 0">
                                        <field class="field" name="bill_file" filename="filename"
                                            readonly="bill_status != '0'"
                                            widget="pdf_viewer" />
                                    </div>

                                    <div invisible="pdf_view_status == 1">
                                        <field class="field" name="bill_file" filename="filename"
                                            readonly="bill_status != '0'" />
                                    </div>

                                    <field class="field" name="filename" invisible="1"
                                        readonly="bill_status != '0'" />

                                </div>

                                <div class="container_button">
                                    <div invisible="pdf_view_status == 1 or bill_file == False">
                                        <button name="update_pdf_view" class="btnSecondary mybutton"
                                            type="object" string="Ver PDF" />
                                    </div>

                                    <div invisible="pdf_view_status == 0 or bill_file == False">
                                        <button name="update_pdf_view" class="btnSecondary mybutton"
                                            type="object" string="Fechar PDF" />
                                    </div>

                                </div>

                            </div>

                        </section>

                        <section class="group">

                            <div class="subgroup">
                                <div class="container_field">
                                    <span>Data de Registro:</span>
                                    <field class="field" name="register_date" readonly='1' />
                                </div>

                                <div class="container_field">
                                    <span>Data de Vencimento:</span>
                                    <field class="field" name="validation_date"
                                        readonly="bill_status != '0'" />
                                </div>

                            </div>

                            <div class="subgroup">
                                <div class="container_field">
                                    <span>Tipo de Conta:</span>
                                    <field class="field" name="bill_type"
                                        readonly="bill_status != '0'" />
                                </div>

                                <div class="container_field">
                                    <span>Descrição:</span>
                                    <field class="field" name="description"
                                        readonly="bill_status != '0'" />
                                </div>

                            </div>

                            <div class="subgroup">

                                <div class="container_field"
                                    invisible="bill_type != 'manutencao-veiculo'">
                                    <span>Patrimônio:</span>
                                    <field class="field" name="external_patrimony_id"
                                        widget="selection"
                                        readonly="bill_status != '0'"
                                        required="bill_type == 'manutencao-veiculo'"
                                        domain="[('classification', '=', 'veiculo')]" />
                                </div>

                                <div class="container_field"
                                    invisible="bill_type != 'manutencao-pesado'">
                                    <span>Patrimônio:</span>
                                    <field class="field" name="external_patrimony_id"
                                        widget="selection"
                                        readonly="bill_status != '0'"
                                        required="bill_type == 'manutencao-pesado'"
                                        domain="[('classification', '=', 'pesado')]" />
                                </div>

                                <div class="container_field"
                                    invisible="bill_type not in ['combustivel', 'locacao-veiculo', 'financiamento',
                                    'multa']">
                                    <span>Patrimônio:</span>
                                    <field class="field" name="external_patrimony_id"
                                        widget="selection"
                                        readonly="bill_status != '0'"
                                        required="bill_type in ['combustivel', 'locacao-veiculo', 'financiamento',
                                        'multa']"
                                        domain="[('classification', '!=', 'outro')]" />
                                </div>

                                <div class="container_field"
                                    invisible="bill_type not in ['manutencao-veiculo', 'financiamento', 'manutencao-pesado',
                                    'combustivel', 'locacao-veiculo', 'multa', 'ipva']">
                                    <span>Contrato:</span>
                                    <field class="field" name="external_contract_id"
                                        widget="selection"
                                        readonly="bill_status != '0'"
                                        required="bill_type in ['manutencao-veiculo', 'financiamento', 'manutencao-pesado',
                                    'combustivel', 'locacao-veiculo', 'multa', 'ipva']"
                                        domain="[('status', '=', 'ativo')]" />
                                </div>

                            </div>

                            <div class="container_field"
                                invisible="bill_type not in ['material-obra', 'material-escritorio',
                            'telefone', 'lubrificante']">
                                <span>Patrimônio:</span>
                                <field class="field" name="external_patrimony_id" widget="selection"
                                    readonly="bill_status != '0'"
                                    domain="[('classification', '=', 'outro')]" />
                            </div>

                            <div class="subgroup">
                                <div class="container_field">
                                    <span>Dia de Pagamento:</span>
                                    <field class="field" name="external_operation_id"
                                        widget="selection"
                                        readonly="1" />
                                </div>

                            </div>

                            <div class="container_field">
                                <span>Assinatura:</span>
                                <field class="field" name="signature" widget="signature"
                                    readonly="bill_status != '0'" />
                            </div>

                            <div class="subgroup">
                                <div class="container_field">
                                    <span>Status:</span>
                                    <field class="field" name="bill_status" readonly='1' />
                                </div>

                                <div class="container_button">
                                    <button name="create_bill" class="btnSecondary mybutton"
                                        type="object" string="Salvar"
                                        groups="registers.group__registers_bill_rw,registers.group_registers_superuser"
                                        confirm="Confimar dados de conta?"
                                        invisible="bill_status != '0'" />
                                </div>

                                <div class="container_button">
                                    <button name="remove_external_operation_id" class="btnSecondary mybutton"
                                        type="object" string="Limpar Dia de Pagamento"
                                        groups="registers.group_registers_bill_rw,registers.group_registers_superuser"
                                        confirm="Remover data de pagamento da conta?"
                                        invisible="bill_status != '1'"/>

                                </div>

                                <div class="container_button">
                                    <button name="update_bill_status" class="btnSecondary mybutton"
                                        type="object" string="Atualizar"
                                        groups="registers.group_registers_superuser"
                                        confirm="Autorizar conta?" invisible="bill_status != '0'" />
                                </div>

                            </div>

                        </section>

                    </article>
                </div>
            </form>


        </field>

    </record>

    <record id="view_bill_list" model="ir.ui.view">
        <field name="name">bill.list</field>
        <field name="model">bill</field>
        <field name="arch" type="xml">
            <list string="Despesas" default_order="register_date desc">
                <field class="test" name="id_bill" />
                <field class="test" name="value" />
                <field class="test" name="validation_date" />
                <field class="test" name="bill_status" decoration-info="bill_status == '0'"
                    decoration-success="bill_status == '1'" decoration-primary="bill_status == '2'" />
                <field class="test" name="bill_type" />
            </list>
        </field>
    </record>

    <record id="action_register_bill" model="ir.actions.act_window">
        <field name="name">Despesas</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">bill</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>